# BiolNexo — Env (copiar a .env.local)
# Vite (opcional, para exponer flags al front)
VITE_LLM_ENABLED=false

# Agente IA asistido (Opción A, apagado por defecto)
LLM_ENABLED=false
GEMINI_API_KEY= # aistudio.google.com → Create API key (free tier 60 req/min)
GEMINI_MODEL=gemini-2.0-flash

# Supabase (cuando actives Fase A)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Cron 3×/semana: lunes/miércoles/viernes 06:00 UTC se orquesta en Supabase Cron o Vercel Cron
# No requiere LLM para Fase A (solo recolección DOI)
