{
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "installCommand": "pnpm install",
  "framework": "vite",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "crons": [
    { "path": "/api/cron/agent?area=biotecnologia&lang=es", "schedule": "0 6 * * 1" },
    { "path": "/api/cron/agent?area=tendencias&lang=es", "schedule": "0 6 * * 3" },
    { "path": "/api/cron/agent?area=experimentos-caseros&lang=es", "schedule": "0 6 * * 5" }
  ]
}
